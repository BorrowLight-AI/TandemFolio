# Normalize line endings: everything text is committed with LF and checked
# out as LF on every platform, so Windows clones (core.autocrlf=true) don't
# fail the incremental prettier --check CI gate on CRLF.
* text=auto eol=lf

# Binary assets — never normalized or diffed as text.
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Generated single-file plugin bundles contain upstream template literals whose
# whitespace is not a hand-maintained source concern.
plugins/tandemfolio/assets/editor/index.html -diff
plugins/tandemfolio/assets/editors/*/index.html -diff
plugins/tandemfolio/dist/* -diff

# Documentation media should never be treated as text or merged line-by-line.
*.mp4 binary
*.gif binary
